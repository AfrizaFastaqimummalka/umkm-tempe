# ─────────────────────────────────────────────
# UMKM Tempe Backend — Environment Variables
# Salin file ini menjadi .env dan isi nilainya
# JANGAN commit file .env ke git!
# ─────────────────────────────────────────────

# Django
SECRET_KEY=ganti-dengan-secret-key-yang-panjang-dan-random
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,backend-six-psi-60.vercel.app

# NeonDB PostgreSQL
# Ambil dari dashboard NeonDB → Connection string
# DATABASE_URL=postgresql://user:password@ep-xxxx.neon.tech/neondb?sslmode=require

# CORS — URL frontend React kamu
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://umkm-tempe.vercel.app

# Telegram Bot
# Ambil dari @BotFather di Telegram
TELEGRAM_BOT_TOKEN=1234567890:ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghi

# Chat ID admin (ambil dari @userinfobot)
TELEGRAM_ALLOWED_CHAT_IDS=123456789
